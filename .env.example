# ---------------------------------------------------------------------------
# VIP Drivers - environment
# Copy this file to .env.local and fill in the values you have. The app boots
# with only DATABASE_URL and AUTH_SECRET; everything else unlocks a feature
# and degrades safely while it is missing.
#
# When configuring a HOSTING PROVIDER rather than a local file, simply leave
# out the variables you have no value for yet. Use the exact names below, and
# paste values without surrounding quotes or < > brackets.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Neon (production) or a local Postgres. Use the POOLED Neon connection string.
DATABASE_URL="postgresql://user:password@host/vipdrivers?sslmode=require"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public URL of the deployment. Leave this OUT on Vercel: the app falls back to
# the URL Vercel assigns, so preview deployments address themselves correctly
# too. Set it only once you have your own domain, e.g. https://vipdrivers.be
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails that become administrators on first sign-in. Comma separated.
ADMIN_EMAILS="you@example.com"

# --- Google sign-in ---------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe (card, Apple Pay, Google Pay) -----------------------------------
# Test keys are safe: no real money moves. dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From the webhook endpoint you create for <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# --- PayPal (optional) ------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- Mapbox (address autocomplete + real driven distance) -------------------
# account.mapbox.com - free tier, no credit card required.
# Keep this SECRET: all Mapbox calls are proxied through the server.
MAPBOX_TOKEN=""

# --- Web push notifications -------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@vipdrivers.be"

# --- Transactional email (optional) -----------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="VIP Drivers <bookings@yourdomain.be>"
OPERATIONS_EMAIL="ops@yourdomain.be"

# --- Behaviour flags --------------------------------------------------------
# Lets a booking be marked paid without Stripe, to demo the flow end to end.
# Defaults to true in development, false in production.
DEMO_PAYMENTS=""
